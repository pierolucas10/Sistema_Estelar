# ============================================================
#  Estelar · .htaccess de la carpeta raíz del proyecto (VOZ/)
#  Permite subir la carpeta completa dentro del sitio:
#  https://tudominio.com/VOZ/  →  se sirve desde VOZ/public_html/
# ============================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Carpetas y archivos privados: nunca accesibles desde internet
    RewriteRule ^(config|src|install|tests|logs|storage)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(md|sql|log|ini|json)$ - [F,NC,L]

    # Todo lo demás se sirve desde public_html/
    RewriteCond %{REQUEST_URI} !/public_html/
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>

<FilesMatch "(^\.|\.(md|sql|log|ini)$)">
    Require all denied
</FilesMatch>
